rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 문서 ID가 곧 학생 코드. "익명 인증 + 코드 재연결(reclaim-on-login)" 모델:
    // 코드를 아는 사람이 그 학생으로 간주된다. 학생은 linkedUid/lastLoginAt만
    // 갱신할 수 있고, 그 외 필드(teacherId 등)는 교사만 변경할 수 있다.
    match /students/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == resource.data.teacherId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.teacherId
                    && request.resource.data.linkedUid == null;
      allow update: if request.auth != null && (
                      request.auth.uid == resource.data.teacherId
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['linkedUid', 'lastLoginAt'])
                        && request.resource.data.linkedUid == request.auth.uid
                      )
                    );
      allow delete: if request.auth != null && request.auth.uid == resource.data.teacherId;
    }

    match /teachers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 제출물은 작성 후 수정/삭제 불가(불변 기록). 권한은 studentUid를 직접
    // 비교하지 않고 studentCode -> students/{code}.linkedUid 조회로 판단한다
    // ("현재 이 코드를 재연결한 사람인가?"). uid로 직접 비교하면 학생이
    // 실습실처럼 다른 기기(다른 익명 uid)로 재접속했을 때 예전 제출물을
    // 영영 못 보는 문제가 생긴다 — 코드 재연결 모델의 핵심 전제(기기 무관)와
    // 어긋나므로 반드시 코드 기준으로 권한을 확인해야 한다.
    match /submissions/{id} {
      allow create: if request.auth != null
                    && request.resource.data.studentUid == request.auth.uid
                    && request.auth.uid == get(
                         /databases/$(database)/documents/students/$(request.resource.data.studentCode)
                       ).data.linkedUid;
      allow read: if request.auth != null && (
                    resource.data.teacherId == request.auth.uid
                    || request.auth.uid == get(
                         /databases/$(database)/documents/students/$(resource.data.studentCode)
                       ).data.linkedUid
                  );
      allow update, delete: if false;
    }
  }
}
