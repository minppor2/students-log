rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 문서 ID가 곧 학생 코드. "익명 인증 + 코드 재연결(reclaim-on-login)" 모델:
    // 코드를 아는 사람이 그 학생으로 간주된다. 학생은 linkedUid/lastLoginAt만
    // 갱신할 수 있고, 그 외 필드(teacherId 등)는 교사만 변경할 수 있다.
    match /students/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == resource.data.teacherId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.teacherId
                    && request.resource.data.linkedUid == null;
      allow update: if request.auth != null && (
                      request.auth.uid == resource.data.teacherId
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['linkedUid', 'lastLoginAt'])
                        && request.resource.data.linkedUid == request.auth.uid
                      )
                    );
      allow delete: if request.auth != null && request.auth.uid == resource.data.teacherId;
    }

    match /teachers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 제출물은 작성 후 수정/삭제 불가(불변 기록). 학생은 자신의 제출물만,
    // 교사는 자기 반 제출물만 읽을 수 있어 학생 간 열람이 서버 단에서 막힌다.
    match /submissions/{id} {
      allow create: if request.auth != null
                    && request.resource.data.studentUid == request.auth.uid;
      allow read: if request.auth != null && (
                    resource.data.studentUid == request.auth.uid
                    || resource.data.teacherId == request.auth.uid
                  );
      allow update, delete: if false;
    }
  }
}
